rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.admin == true;
    }

    match /hero/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /about/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /whyChoose/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /seo/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /socialLinks/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /gallery/{galleryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /offers/{offerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /enquiries/{enquiryId} {
      allow read: if isAdmin();
      // Allow public creation of enquiries but validate field types and reasonable lengths.
      allow create: if
        // required keys
        request.resource.data.keys().hasAll(['name', 'phone', 'email', 'service', 'message'])
        // Public callers cannot set admin-managed state or timestamps.
        && request.resource.data.keys().hasOnly(['name', 'phone', 'email', 'service', 'message', 'quantity'])
        // type checks
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.email is string
        && request.resource.data['service'] is string
        && request.resource.data.message is string
        // max length checks
        && request.resource.data.name.size() <= 100
        && request.resource.data.phone.size() <= 32
        && request.resource.data.email.size() <= 254
        && request.resource.data['service'].size() <= 100
        && request.resource.data.message.size() <= 2000
        // optional quantity
        && (
          !(request.resource.data.keys().hasAll(['quantity']))
          || (request.resource.data.quantity is string && request.resource.data.quantity.size() <= 100)
        )
        // basic phone/email patterns
          && request.resource.data.phone.matches('^[0-9+() -]{5,32}$')
          && request.resource.data.email.matches('^[^ @]+@[^ @]+[.][^ @]+$');
      allow update, delete: if isAdmin();
    }

    match /siteSettings/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}